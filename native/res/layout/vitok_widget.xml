<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/vitok_widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Виток"
        android:textColor="#bff36a"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vw_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#edf3ee"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vw_sparks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#bff36a"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vw_min"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8a9b92"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/vw_habits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8a9b92"
        android:textSize="12sp" />
</LinearLayout>
